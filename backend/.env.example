# Ocular Backend Environment Configuration

# Server Port
PORT=5000

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# JWT Secret Key for Session Authentication
JWT_SECRET=ocular_super_secure_jwt_secret_change_in_production_9921

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
# CRITICAL SECURITY RULE: Stored strictly on backend, NEVER exposed to client.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Configuration (Obtain from https://supabase.com/dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
# Use Service Role Key for backend administration bypass of RLS, or Anon Key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key_here
